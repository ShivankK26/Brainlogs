{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainlogs",
  "version": "1.0.13",
  "identifier": "io.brainlog.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && node ../../tooling/release/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brainlogs",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "visible": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/tray.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": false
    },
    "externalBin": [
      "binaries/brainlogs-node"
    ],
    "resources": [
      "bundle-res/core/**/*",
      "bundle-res/ui/**/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ3OUI2RUI1OTkzMUIzQzQKUldURXN6R1p0VzZiMTRST1NYeG1RZEMvSEVGL2g0SnlzS2JPS2NhYXFqRFFNU3dGWUp4cXJ1MzgK",
      "endpoints": [
        "https://github.com/ShivankK26/Brainlog/releases/latest/download/latest.json"
      ]
    }
  }
}
