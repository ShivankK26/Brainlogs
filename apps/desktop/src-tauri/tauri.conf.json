{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brainlogs",
  "version": "1.0.3",
  "identifier": "io.brainlog.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build && node ../../tooling/release/prepare-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Brainlogs",
        "width": 400,
        "height": 680,
        "minWidth": 56,
        "minHeight": 56,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "center": false
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "msi",
      "nsis",
      "deb",
      "appimage",
      "rpm"
    ],
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "infoPlist": "Info.plist",
      "signingIdentity": "-",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      }
    },
    "externalBin": [
      "binaries/brainlogs-node"
    ],
    "resources": [
      "bundle-res/core/**/*",
      "bundle-res/ui/**/*"
    ]
  },
  "plugins": {}
}
