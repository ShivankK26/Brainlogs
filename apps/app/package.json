{
  "name": "@brainlog/app",
  "version": "1.0.14",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test:e2e": "playwright test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@brainlog/types": "workspace:*",
    "@brainlog/ui": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@brainlog/capture": "workspace:*",
    "@brainlog/core": "workspace:*",
    "@brainlog/enrich": "workspace:*",
    "@brainlog/eslint-config": "workspace:*",
    "@brainlog/tsconfig": "workspace:*",
    "@brainlog/worker": "workspace:*",
    "@playwright/test": "^1.53.0",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "@brainlog/query": "workspace:*"
  }
}
