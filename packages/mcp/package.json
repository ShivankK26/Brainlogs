{
  "name": "@brainlog/mcp",
  "version": "1.4.1",
  "license": "MIT",
  "description": "Brainlogs MCP server: gives Claude Code, Cursor and Codex a memory of your week over stdio or a local socket. Writes are held as proposed until you approve them.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./stdio": "./src/stdio.ts"
  },
  "bin": {
    "brainlog-mcp": "./bin/brainlog-mcp.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "start": "tsx src/stdio.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@brainlog/core": "workspace:*",
    "@brainlog/policy": "workspace:*",
    "@brainlog/query": "workspace:*",
    "@brainlog/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@brainlog/capture": "workspace:*",
    "@brainlog/enrich": "workspace:*",
    "@brainlog/eslint-config": "workspace:*",
    "@brainlog/tsconfig": "workspace:*",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
