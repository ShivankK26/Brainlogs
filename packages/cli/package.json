{
  "name": "@brainlog/cli",
  "version": "1.0.13",
  "license": "MIT",
  "description": "brainlog — command-line access to your local Brainlogs memory.",
  "type": "module",
  "bin": {
    "brainlog": "./bin/brainlog.js"
  },
  "main": "./src/index.ts",
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@brainlog/core": "workspace:*",
    "@brainlog/enrich": "workspace:*",
    "@brainlog/query": "workspace:*",
    "@brainlog/types": "workspace:*",
    "@brainlog/worker": "workspace:*",
    "@brainlog/mcp": "workspace:*"
  },
  "devDependencies": {
    "@brainlog/eslint-config": "workspace:*",
    "@brainlog/tsconfig": "workspace:*",
    "eslint": "^9.28.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
