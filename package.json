{
  "name": "brainlog",
  "version": "1.0.8",
  "private": true,
  "license": "MIT",
  "description": "Brainlog — a local-first second brain. Captures the text of what you see, builds an entity graph on-device, and answers questions about your past. Nothing leaves your machine.",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShivankK26/Brainlog.git"
  },
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules/.cache",
    "dev:app": "pnpm --filter @brainlog/app dev",
    "dev:worker": "pnpm --filter @brainlog/worker dev",
    "dev:desktop": "pnpm --filter @brainlog/desktop tauri dev",
    "dev:site": "pnpm --filter @brainlog/site dev",
    "start": "node scripts/start-app.mjs",
    "build:desktop": "node scripts/build-desktop.mjs",
    "sign:mac": "node scripts/sign-macos.mjs",
    "package:app": "pnpm build && pnpm build:desktop && pnpm sign:mac",
    "db:migrate": "pnpm --filter @brainlog/core db:migrate",
    "db:seed": "pnpm --filter @brainlog/core db:seed",
    "brainlog": "pnpm --filter @brainlog/cli start --",
    "mcp": "pnpm --filter @brainlog/mcp start",
    "changeset": "changeset",
    "release:version": "changeset version",
    "release:publish": "changeset publish",
    "bundle:core": "node tooling/release/prepare-bundle.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@types/node": "^22.15.3",
    "tsx": "^4.19.4",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "esbuild": "^0.25.5"
  }
}
